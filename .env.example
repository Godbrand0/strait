# Bitcoin
# Bitcoin RPC credentials are OPTIONAL (legacy): all Bitcoin state is read
# through the BitcoinKit precompile on Hemi — no Bitcoin node is required.
# BITCOIN_RPC_URL=http://localhost:8332
# BITCOIN_RPC_USER=user
# BITCOIN_RPC_PASSWORD=password
BITCOIN_TUNNEL_ADDRESSES=bc1q...,...   # comma-separated custody addresses to watch
BITCOIN_CONFIRMATION_DEPTH=6

# Hemi (mainnet — chain ID 43111)
HEMI_RPC_URL=https://rpc.hemi.network/rpc
HEMI_CHAIN_ID=43111
# ETH/ERC-20 routes: L2StandardBridge (confirmed, well-known OP Stack address)
HEMI_TUNNEL_CONTRACT=0x4200000000000000000000000000000000000010
# BTC routes: BitcoinTunnelManager (confirmed from Hemi explorer + hemilabs/bitcoin-tunnel-contracts)
HEMI_BTC_TUNNEL_CONTRACT=0xEAcA824F46c000fB89403846Bb57e6b913321081
# BitcoinKit v1 precompile (confirmed from Hemi mainnet explorer)
HEMI_BITCOIN_KIT_CONTRACT=0x7007dd1C09527B92AEcd8Ae6570B73d09E0B8F12
HEMI_START_BLOCK=0
HEMI_CONFIRMATION_DEPTH=3

# Hemi Sepolia (testnet — chain ID 743111) — uncomment to use testnet instead
# HEMI_RPC_URL=https://testnet.rpc.hemi.network/rpc
# HEMI_CHAIN_ID=743111
# HEMI_TUNNEL_CONTRACT=0x4200000000000000000000000000000000000010
# HEMI_BTC_TUNNEL_CONTRACT=0x8221CFD3Eca3c5F9FA27b2AE774151642f1C449e
# HEMI_BITCOIN_KIT_CONTRACT=0xeC9fa5daC1118963933e1A675a4EEA0009b7f215

# Ethereum mainnet
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_CHAIN_ID=1
# L1StandardBridgeProxy on Ethereum mainnet (confirmed from Hemi contract addresses doc)
ETH_TUNNEL_CONTRACT=0x5eaa10F99e7e6D177eF9F74E519E319aa49f191e
ETH_START_BLOCK=0
ETH_CONFIRMATION_DEPTH=12

# Ethereum Sepolia (testnet) — uncomment to use testnet instead
# ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# ETH_CHAIN_ID=11155111
# L1StandardBridgeProxy on Sepolia (confirmed from Hemi contract addresses doc)
# ETH_TUNNEL_CONTRACT=0xc94b1BEe63A3e101FE5F71C80F912b4F4b055925

# Database
# Local Postgres (development):
DATABASE_URL=postgres://postgres:password@localhost:5432/strait?sslmode=disable
# Supabase (production): use the *Session pooler* connection string (IPv4 + prepared
# statements). The direct db.<ref>.supabase.co host is IPv6-only. See docs/supabase-setup.md
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# API
API_HOST=0.0.0.0
API_PORT=8080
