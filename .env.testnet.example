# ─────────────────────────────────────────────────────────────────────────────
# Strait — TESTNET config (Hemi Sepolia 743111 + Ethereum Sepolia 11155111)
#
# Run testnet WITHOUT touching your mainnet .env:
#   set -a; source .env.testnet; set +a
#   cargo run -p strait-node
# (dotenv won't override already-exported vars, so these win over .env.)
#
# ⚠️  Use a SEPARATE database from mainnet — otherwise testnet and mainnet
#     transfers land in the same tables and mix together.
# ─────────────────────────────────────────────────────────────────────────────

# Bitcoin (testnet) — leave addresses empty to keep the custody watcher disabled
# Bitcoin RPC credentials are OPTIONAL (legacy): all Bitcoin state is read
# through the BitcoinKit precompile on Hemi — no Bitcoin node is required.
# BITCOIN_RPC_URL=http://localhost:18332
# BITCOIN_RPC_USER=user
# BITCOIN_RPC_PASSWORD=password
BITCOIN_TUNNEL_ADDRESSES=
BITCOIN_CONFIRMATION_DEPTH=3

# Hemi Sepolia (testnet — chain ID 743111)
HEMI_RPC_URL=https://testnet.rpc.hemi.network/rpc
HEMI_CHAIN_ID=743111
HEMI_TUNNEL_CONTRACT=0x4200000000000000000000000000000000000010
HEMI_BTC_TUNNEL_CONTRACT=0x8221CFD3Eca3c5F9FA27b2AE774151642f1C449e
HEMI_BITCOIN_KIT_CONTRACT=0xeC9fa5daC1118963933e1A675a4EEA0009b7f215
# PoPPayoutsV2 — watches PayoutRoundExecuted to advance BTC->Hemi transfers to ANCHORED
HEMI_POP_PAYOUTS_CONTRACT=0x4a3b61C586DB4CD219E85aC0697b66916c7457AB
# No known SimpleBitcoinVault deployments on Hemi Sepolia yet — leave unset;
# vault custody addresses are auto-discovered from VaultCreated events.
# HEMI_VAULT_CONTRACTS=
# Start a few thousand blocks back from the current testnet tip — NOT 0 (genesis
# backfill is huge). Check the current block at testnet.explorer.hemi.xyz.
HEMI_START_BLOCK=0
HEMI_CONFIRMATION_DEPTH=3
# Public testnet RPC rate-limits aggressively — lower this if you see 429s/errors:
# HEMI_LOG_RANGE=10

# Ethereum Sepolia (testnet — chain ID 11155111)
ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ETH_CHAIN_ID=11155111
ETH_TUNNEL_CONTRACT=0xc94b1BEe63A3e101FE5F71C80F912b4F4b055925
# OptimismPortalProxy — watches WithdrawalProven for HEMI_TO_ETH proving-window tracking
ETH_OPT_PORTAL_CONTRACT=0xB6f9579980aE46f61217A99145645341E49E2516
ETH_START_BLOCK=0
ETH_CONFIRMATION_DEPTH=12
# Public Sepolia RPC providers often cap eth_getLogs range on free tiers:
# ETH_LOG_RANGE=10

# Database — MUST be different from the mainnet DB (separate Supabase project,
# or at least a different database name). Use the Session pooler URI (IPv4 +
# prepared statements) from Project Settings -> Database -> Connection string,
# not the direct db.<ref>.supabase.co host (IPv6-only on some plans).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# API — use a different port so testnet can run alongside the mainnet node (8080).
API_HOST=0.0.0.0
API_PORT=8081
